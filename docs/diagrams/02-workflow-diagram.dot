// Render: neato -n2 -Tpng 02-workflow-diagram.dot -o 02-workflow-diagram.png
// Coordinates are in points, measured from the original image (1 px = 1 pt, y axis flipped).
digraph G {
    layout=neato;
    splines=line;
    bgcolor=white;
    node [shape=box, style=filled, fillcolor="#6ce5d0", color=black, penwidth=2,
          fontname="Times New Roman", fontsize=40, fixedsize=true, label=""];
    edge [color=black, penwidth=2, arrowsize=1.3];

    // ---- main nodes (drawn back to front) ----
    DC   [label="Data Collection",     pos="461,1308",   width=4.194, height=1.722];

    Big  [pos="461.5,805", width=12.375, height=9.444];
    Norm [label="Normal",              pos="212,804.5",  width=4.153, height=1.681, fontsize=40];
    Dot  [style="dotted,filled", pos="635.5,805", width=6.264, height=8.472];
    Pro  [label="Prolongation",        pos="636,1017",   width=4.194, height=1.0, fontsize=26];
    Blk  [label="Block",               pos="636,911.5",  width=4.194, height=1.0, fontsize=26];
    SRep [label="Sound Repetition",    pos="636,805",    width=4.194, height=1.0, fontsize=26];
    WRep [label="Word Repetition",     pos="636,698.5",  width=4.194, height=1.0, fontsize=26];
    Intj [label="Interjection",        pos="636,592.5",  width=4.194, height=1.0, fontsize=26];

    Clean [label="Data cleaning",      pos="461,301.5",  width=4.194, height=1.708];
    Pre   [label="Data\nPreprocessing", pos="461,75.5",  width=4.194, height=1.708];
    Agg   [label="Data Aggregation",   pos="1364,75.5",  width=4.194, height=1.708];

    Train [label="Training",           pos="1052,317.5", width=4.167, height=1.708];
    Val   [label="Validation",         pos="1680.5,317.5", width=4.181, height=1.708];

    HPh [label="Hyper parameter selection", pos="1364,805.5", width=10.389, height=1.542];
    HPp [label="Learning Rate\nDropout Rate\nNo. of. Custom Layers\nOptimizer",
                                       pos="1364,608",   width=10.389, height=3.944];
    TM  [label="Training Model",       pos="1364,994",   width=10.389, height=1.556];

    Dia [shape=diamond, label="Calculation\nof Accuracy, Precision,\nRecall, F1 Score and\nLoss",
                                       pos="2241,995",   width=8.972, height=4.153];
    Rep [label="Clinical Report",      pos="2241.5,694.5", width=4.181, height=1.708];

    // ---- free-floating labels ----
    L1 [shape=plaintext, style="", label="~30,000 samples",          pos="317,1194", width=4.5, height=0.8];
    L2 [shape=plaintext, style="", label="Split 8:1:1",              pos="1265,174", width=3.0, height=0.8];
    L3 [shape=plaintext, style="", label="Mono-channel 16kHz audio", pos="912,37",   width=7.0, height=0.8];

    // ---- invisible waypoints for right-angle edges ----
    node [shape=point, width=0.01, height=0.01, style=invis, label=""];
    JA [pos="1364,217"];  JT [pos="1052,217"];  JV [pos="1680,217"];
    P1 [pos="1053,466"];  P2 [pos="1681,466"];
    W1 [pos="1364,1326"]; W2 [pos="2241,1326"];

    // ---- edges ----
    DC   -> Big;
    Big  -> Clean;
    Clean -> Pre;
    Pre  -> Agg;

    Agg -> JA [arrowhead=none];
    JA  -> JT [arrowhead=none];
    JA  -> JV [arrowhead=none];
    JT  -> Train;
    JV  -> Val;

    Train -> P1;
    Val   -> P2;

    HPh -> TM;

    TM -> W1 [arrowhead=none];
    W1 -> W2 [arrowhead=none];
    W2 -> Dia;
    Dia -> Rep;
}
