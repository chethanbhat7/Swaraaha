\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}In-Distribution Results (RQ1)}{9}{subsection.5.1}\protected@file@percent }
\newlabel{sec:res-indist}{{5.1}{9}{In-Distribution Results (RQ1)}{subsection.5.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Macro F1 (unweighted mean over the five classes) for all seven configurations and two trivial baselines, with 95\% bootstrap confidence intervals on the tuned columns. ``Test'' is the clip-level in-distribution split (3{,}715 scored clips, speakers shared with training); ``Boli'' is the speaker-independent cross-corpus split (53 scored recordings). ``0.5'' applies a fixed threshold; ``tuned'' applies the per-class validation-F1-optimal thresholds of Section~\ref {sec:setup}, unchanged on Boli. The two baselines are untuned, so their columns coincide. Intervals reflect clip-level resampling only and exclude seed variation.}}{9}{table.1}\protected@file@percent }
\newlabel{tab:macro}{{1}{9}{Macro F1 (unweighted mean over the five classes) for all seven configurations and two trivial baselines, with 95\% bootstrap confidence intervals on the tuned columns. ``Test'' is the clip-level in-distribution split (3{,}715 scored clips, speakers shared with training); ``Boli'' is the speaker-independent cross-corpus split (53 scored recordings). ``0.5'' applies a fixed threshold; ``tuned'' applies the per-class validation-F1-optimal thresholds of Section~\ref {sec:setup}, unchanged on Boli. The two baselines are untuned, so their columns coincide. Intervals reflect clip-level resampling only and exclude seed variation}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Cross-Corpus Results at Tuned Thresholds (RQ2)}{10}{subsection.5.2}\protected@file@percent }
\newlabel{sec:res-boli-tuned}{{5.2}{10}{Cross-Corpus Results at Tuned Thresholds (RQ2)}{subsection.5.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Per-class F1 on the speaker-independent cross-corpus set (53 scored recordings) at the validation-tuned thresholds, transferred unchanged. The all-positive row labels every clip positive, giving per-class F1 $2s/(n+s)$ for support $s$ and $n=53$; no configuration exceeds it in macro F1. The macro column carries a 95\% bootstrap interval; per-class intervals are omitted because with support between 9 and 35 they are too wide to inform the comparison (e.g.\ arm06 block, 0.795, 95\% CI 0.691--0.873).}}{10}{table.2}\protected@file@percent }
\newlabel{tab:boli_perclass}{{2}{10}{Per-class F1 on the speaker-independent cross-corpus set (53 scored recordings) at the validation-tuned thresholds, transferred unchanged. The all-positive row labels every clip positive, giving per-class F1 $2s/(n+s)$ for support $s$ and $n=53$; no configuration exceeds it in macro F1. The macro column carries a 95\% bootstrap interval; per-class intervals are omitted because with support between 9 and 35 they are too wide to inform the comparison (e.g.\ arm06 block, 0.795, 95\% CI 0.691--0.873)}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Threshold-Free Cross-Corpus Results and Operating-Point Drift (RQ3, RQ4)}{11}{subsection.5.3}\protected@file@percent }
\newlabel{sec:res-thresholdfree}{{5.3}{11}{Threshold-Free Cross-Corpus Results and Operating-Point Drift (RQ3, RQ4)}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Threshold-free macro metrics and predicted-positive rate (PPR) from the same predictions as Table~\ref {tab:boli_perclass}. AUROC and AUPRC are point estimates; AUPRC lift is relative to the macro base rate 0.408, its chance level. PPR is the mean fraction of clips labelled positive at the tuned thresholds, so it measures where the operating point landed rather than performance, and it carries a 95\% bootstrap interval. The two PPR columns apply identical thresholds to the two evaluation sets, so their difference measures drift directly. Base-rate rows give the in-distribution (0.143) and external (0.408) priors.}}{11}{table.3}\protected@file@percent }
\newlabel{tab:boli_drift}{{3}{11}{Threshold-free macro metrics and predicted-positive rate (PPR) from the same predictions as Table~\ref {tab:boli_perclass}. AUROC and AUPRC are point estimates; AUPRC lift is relative to the macro base rate 0.408, its chance level. PPR is the mean fraction of clips labelled positive at the tuned thresholds, so it measures where the operating point landed rather than performance, and it carries a 95\% bootstrap interval. The two PPR columns apply identical thresholds to the two evaluation sets, so their difference measures drift directly. Base-rate rows give the in-distribution (0.143) and external (0.408) priors}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The two metric families disagree, and the mechanism is visible. (a) Operating-point drift on the cross-corpus set (RQ3): macro predicted-positive rate at the in-distribution-tuned thresholds, against the 0.408 macro base rate (dashed), as in Table~\ref {tab:boli_drift}. (b) RQ2 against RQ4: cross-corpus macro F1 (solid) against macro AUROC (hatched); no configuration reaches the all-positive F1 line, and the two orderings are near-reversals.}}{12}{figure.1}\protected@file@percent }
\newlabel{fig:charts}{{1}{12}{The two metric families disagree, and the mechanism is visible. (a) Operating-point drift on the cross-corpus set (RQ3): macro predicted-positive rate at the in-distribution-tuned thresholds, against the 0.408 macro base rate (dashed), as in Table~\ref {tab:boli_drift}. (b) RQ2 against RQ4: cross-corpus macro F1 (solid) against macro AUROC (hatched); no configuration reaches the all-positive F1 line, and the two orderings are near-reversals}{figure.1}{}}
