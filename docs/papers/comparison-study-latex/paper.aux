\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Per-class metrics for the multitask Wav2Vec2 model (arm02) on the in-distribution test split (3{,}715 scored clips) at the validation-tuned thresholds 0.55, 0.35, 0.40, 0.35, and 0.45 for prolongation, block, sound repetition, word repetition, and interjection. Base rate is support divided by 3{,}715, the chance level of AUPRC for that class. F1 carries a 95\% bootstrap interval.}}{13}{table.4}\protected@file@percent }
\newlabel{tab:perclass}{{4}{13}{Per-class metrics for the multitask Wav2Vec2 model (arm02) on the in-distribution test split (3{,}715 scored clips) at the validation-tuned thresholds 0.55, 0.35, 0.40, 0.35, and 0.45 for prolongation, block, sound repetition, word repetition, and interjection. Base rate is support divided by 3{,}715, the chance level of AUPRC for that class. F1 carries a 95\% bootstrap interval}{table.4}{}}
